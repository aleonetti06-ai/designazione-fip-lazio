# Copiare solo nella configurazione PRIVATA di Streamlit. Non commettere secrets.toml.
# Il valore vuoto impedisce l'accesso finché il proprietario non lo configura.
app_password = ""

# Archivio permanente PRIVATO. Vedere CONFIGURA_STORICO.md.
# Inserire l'ID del foglio già predisposto, non l'intero URL.
[history_store]
spreadsheet_id = ""
worksheet = "Eventi"

# Valori del file JSON dell'account di servizio autorizzato a modificare il foglio.
# Non inserire qui credenziali reali: questo file di esempio è pubblico.
[history_store.service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = """"""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
